---
layout: base.njk
title: Jonathan Thompson – Director, Writer, Editor
og_title: Jonathan Thompson – Director, Writer, Editor
description: Jonathan Thompson is a filmmaker based in Atlanta, GA. Explore his projects in film, screenplays, advertisements, and more.
canonical: https://itsjonathanthompson.com/
og_image:
pagecss: <link rel="stylesheet" href="/resources/css/index.css">
pagejs: <script src="/resources/js/index.js" defer></script>
---

<h1 class="visually-hidden">{{ title }}</h1>
<section class="visually-hidden" aria-labelledby="all-works-index">
  <h2 id="all-works-index">All works</h2>
  <ul>
    {% set sortedData = data | sortByDate %}
    {% for i in sortedData %}
      {% set roles = i.role.split('/') %}
      <li>
        <a href="/explore/{{ i.slug }}/">{{ i.title }}</a>
        {% if i.date %} — <time datetime="{{ i.date | isoDate }}">{{ i.date }}</time>{% endif %}
        {% if roles.length or i.type %}
          —
          {% if roles.length %}
            {{ roles | join(", ") }}
          {% endif %}
          {% if roles.length and i.type %} — {% endif %}
          {% if i.type %}
            {{ i.type }}
          {% endif %}
        {% endif %}
         {% if i.Screenplay == "Yes" or i.Screenplay == "Sole" %}
          — {% if i.Screenplay != "Sole" %}Contains{% endif %} Screenplay{% if i.versioning == "Yes" or i.versioning == "Completed" %} (v{{ i.versionInfo.currentVersion }}){% endif %}
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</section>
<div id="content">
    {% set sortedData = data | sortByDate %}
    {% set firstThree = [] %}
    {% for i in sortedData %}
        {% if i.Screenplay != "Sole" and firstThree.length < 3 %}
            {% set firstThree = firstThree.concat([i]) %}
        {% endif %}
    {% endfor %}

    {% for i in firstThree %}
        <div class="contentContainer pop-in"> 
            <a class="frame" href="/explore/{{ i.slug }}">
                <img class="thumbnail active" src="{{ i.imgSrc }}" alt="Thumbnail for {{ i.title }}">
                <video class="thumbnail passive" src="{{ i.previewSrc }}" muted loop aria-label="Preview video for {{ i.title }}"></video>
            </a>
            <div class="info">
                <a class="expand" href="/explore/{{ i.slug }}" tabindex="-1" aria-hidden="true"></a>
                <h2 class="contentTitle">{{ i.title }}</h2>
                <h3 class="date"><time datetime="{{ i.date }}">{{ i.date }}</time></h3>
                {% set roles = i.role.split('/') %}
                <div class="roles" aria-label="Roles">
                    {% for r in roles %}<a class="role-tag" href="/explore/?roles={{ r | urlencode }}">{{ r }}</a>{% endfor %}
                </div>
            </div>
        </div>
    {% endfor %}
</div>
<div id="loadMore">
    <button type="button" class="button" aria-label="Load more projects">Load More</button>
</div>
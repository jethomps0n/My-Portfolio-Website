---
layout: base.njk
og_site_name: "Jonathan Thompson · Blog"
pagecss: <link rel="stylesheet" href="/resources/css/blog.css">
pagejs: <script src="/resources/js/blog.js" defer></script>
---

<article class="blog-post-single">
    <header class="post-header">
        <div class="post-meta">
            <div class="post-meta-tags">
                {% for tag in tags %}
                <a href="/blog/tags/{{ tag | slugify }}/" class="post-category {{ tag | slugify }}" aria-label="Show posts tagged {{ tag | titleCase }}">{{ tag | titleCase }}</a>
                {% endfor %}
            </div>
            <div class="post-meta-info">
                <span class="post-date">{{ date | dateFormat }}</span>
                {% if updated and updated.trim() %}
                <span class="post-updated">Updated <em>{{ updated | dateFormat }}</em></span>
                {% endif %}
            </div>
        </div>
        <h1 class="post-title" aria-label="Blog post title: {{ title }}">{{ title }}</h1>
        {% if excerpt %}
        <p class="post-excerpt">{{ excerpt }}</p>
        {% endif %}
    </header>
    
    <div class="post-content">
        {% if videoLink %}
        <div class="video-container">
            <div class="video-player">
                <iframe
                    src="{{ videoLink | replace('https://www.youtube.com/watch?v=', 'https://www.youtube.com/embed/') | replace('https://youtu.be/', 'https://www.youtube.com/embed/') }}"
                    allowfullscreen
                    allowtransparency
                    allow="autoplay"
                ></iframe>
            </div>
        </div>
        {% endif %}
        {{ content | safe }}
    </div>
    
    <div class="post-footer">
        <div class="post-navigation">
            <a href="/blog/" class="nav-link" aria-label="Back to Blog">← Back to Blog</a>
            <a href="/blog/posts/" class="nav-link" aria-label="View all blog posts">All Posts →</a>
        </div>
        
        {% if tags and tags.length > 0 %}
        <div class="post-tags">
            <h3>Tagged with:</h3>
            <div class="tag-links">
                {% for tag in tags %}
                <a href="/blog/tags/{{ tag | slugify }}/" class="tag-link" aria-label="Show posts tagged {{ tag | titleCase }}">{{ tag | titleCase }}</a>
                {% endfor %}
            </div>
        </div>
        {% endif %}
    </div>
</article>

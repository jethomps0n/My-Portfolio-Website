---
layout: base.njk
pagecss: <link rel="stylesheet" href="/resources/css/blog.css">
pagejs: <script src="/resources/js/blog.js" defer></script>
---

<article class="blog-post-single">
    <header class="post-header">
        <div class="post-meta">
            {% for tag in tags %}
            <a href="/blog/tags/{{ tag | slugify }}/" class="post-category {{ tag | slugify }}">{{ tag | titleCase }}</a>
            {% endfor %}
            <span class="post-date">{{ date | dateFormat }}</span>
        </div>
        <h1 class="post-title">{{ title }}</h1>
        {% if excerpt %}
        <p class="post-excerpt">{{ excerpt }}</p>
        {% endif %}
    </header>
    
    <div class="post-content">
        {% if videoLink %}
        <div class="video-container">
            <div class="video-player">
                <iframe
                    src="{{ videoLink | replace('https://www.youtube.com/watch?v=', 'https://www.youtube.com/embed/') | replace('https://youtu.be/', 'https://www.youtube.com/embed/') }}"
                    allowfullscreen
                    allowtransparency
                    allow="autoplay"
                ></iframe>
            </div>
        </div>
        {% endif %}
        {{ content | safe }}
    </div>
    
    <footer class="post-footer">
        <div class="post-navigation">
            <a href="/blog/" class="nav-link">← Back to Blog</a>
            <a href="/blog/posts/" class="nav-link">All Posts →</a>
        </div>
        
        {% if tags and tags.length > 0 %}
        <div class="post-tags">
            <h3>Tagged with:</h3>
            <div class="tag-links">
                {% for tag in tags %}
                <a href="/blog/tags/{{ tag | slugify }}/" class="tag-link">{{ tag | titleCase }}</a>
                {% endfor %}
            </div>
        </div>
        {% endif %}
    </footer>
</article>

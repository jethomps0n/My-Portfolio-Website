---
pagination:
  data: data
  size: 1
  alias: i
  addAllPagesToCollections: true
permalink: "/explore/{{ i.slug }}/"
layout: base.njk
eleventyComputed:
    title: "{{ i.title }}"
    og_title: "{{ i.title }} - Jonathan Thompson"
    description: "{{ i.description | truncate(160) }}"
    canonical: "https://itsjonathanthompson.com/explore/{{ i.slug }}/"
    og_image:
    pagecss: >
        <link rel="stylesheet" href="/resources/css/project.css">
        {% if i.Screenplay == "Sole" %}<link rel="stylesheet" href="/resources/css/pdf-viewer.css">{% endif %}
        {% if i.Screenplay != "Sole" %}<link rel="stylesheet" href="/resources/css/video-viewer.css">{% endif %}
    pagejs: >
        <script src="/resources/js/project.js" defer></script>
        {% if i.Screenplay == "Sole" %}<script type="module" src="/resources/js/pdf-viewer.js" defer></script>{% endif %}
        {% if i.Screenplay != "Sole" %}<script type="module" src="/resources/js/video-viewer.js" defer></script>{% endif %}
---

<div id="project-page">
    <div id="content-box">
        <section id="project">
            <div id="frame">
                {% if i.Screenplay == "Sole" %}
                 <div id="pdf-viewer" data-pdf="{{ i.PDFSrc }}">
                    <div id="pdf-container">
                        <div id="pdf-sidebar"></div>
                        <div id="pdf-canvas-container">
                            <div id="pdf-pages"></div>
                        </div>
                    </div>
                    <div id="pdf-controls">
                        <div class="pdf-controls-left">
                            <button id="pdf-sidebar-toggle" title="Toggle PDF sidebar" aria-label="Toggle PDF sidebar">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16"><path fill="#fff" fill-rule="evenodd" d="M6 2.5h7a.5.5 0 0 1 .5.5v10a.5.5 0 0 1-.5.5H6zm-1.5 0H3a.5.5 0 0 0-.5.5v10a.5.5 0 0 0 .5.5h1.5zM1 3a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2z" clip-rule="evenodd"/></svg>
                            </button>
                        </div>
                        <div class="pdf-controls-center">
                            <div class="pdf-nav-group">
                                <button id="pdf-prev" title="Previous PDF page" aria-label="Previous PDF page">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="#fff" d="m4.431 12.822l13 9A1 1 0 0 0 19 21V3a1 1 0 0 0-1.569-.823l-13 9a1.003 1.003 0 0 0 0 1.645"/></svg>
                                </button>
                                <input id="pdf-page-num" value="1" min="1" aria-label="Current PDF page number">
                                <span class="pdf-page-info">/  <span id="pdf-page-count">1</span></span>
                                <button id="pdf-next" title="Next PDF page" aria-label="Next PDF page">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="#fff" d="M5.536 21.886a1 1 0 0 0 1.033-.064l13-9a1 1 0 0 0 0-1.644l-13-9A1 1 0 0 0 5 3v18a1 1 0 0 0 .536.886"/></svg>
                                </button>
                            </div>
                            <div class="pdf-zoom-group">
                                <button id="pdf-zoom-out" title="Zoom out" aria-label="Zoom out">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M19 11H5a1 1 0 0 0 0 2h14a1 1 0 0 0 0-2"/></svg>
                                </button>

                                <div class="custom-zoom-dropdown">
                                    <button class="dropdown-trigger" aria-label="PDF zoom level" title="Select zoom level">
                                        <span class="selected-value">Automatic Zoom</span>
                                        <span class="dropdown-icon">▼</span>
                                    </button>
                                    <ul class="dropdown-options">
                                        <li data-value="auto">Automatic Zoom</li>
                                        <li data-value="fit">Page Fit</li>
                                        <li data-value="width">Page Width</li>
                                        <li data-value="0.5">50%</li>
                                        <li data-value="0.75">75%</li>
                                        <li data-value="1">100%</li>
                                        <li data-value="1.25">125%</li>
                                        <li data-value="1.5">150%</li>
                                        <li data-value="2">200%</li>
                                        <li data-value="3">300%</li>
                                        <li data-value="0.25" style="display: none;">25%</li>
                                        <li data-value="1.75" style="display: none;">175%</li>
                                        <li data-value="2.25" style="display: none;">225%</li>
                                        <li data-value="2.5" style="display: none;">250%</li>
                                        <li data-value="2.75" style="display: none;">275%</li>
                                    </ul>
                                </div>

                                <input type="hidden" id="pdf-zoom-select" value="1">

                                <button id="pdf-zoom-in" title="Zoom in" aria-label="Zoom in">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M19 11h-6V5a1 1 0 0 0-2 0v6H5a1 1 0 0 0 0 2h6v6a1 1 0 0 0 2 0v-6h6a1 1 0 0 0 0-2"/></svg>
                                </button>
                            </div>
                        </div>
                        <div class="pdf-controls-right">
                            <button id="pdf-download" title="Download PDF" aria-label="Download PDF">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="#fff" d="M12 2a1 1 0 0 1 1 1v10.586l2.293-2.293a1 1 0 0 1 1.414 1.414l-4 4a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L11 13.586V3a1 1 0 0 1 1-1M5 17a1 1 0 0 1 1 1v2h12v-2a1 1 0 1 1 2 0v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2a1 1 0 0 1 1-1"/></svg>
                            </button>
                            <button id="pdf-print" title="Print PDF" aria-label="Print PDF">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="#fff" d="M22.909 4.363h-3.272V1.091C19.637.488 19.148 0 18.546 0H5.455c-.603 0-1.091.489-1.091 1.091v3.272H1.092c-.603 0-1.091.489-1.091 1.091v13.091c0 .603.489 1.091 1.091 1.091h3.272v3.273c0 .603.489 1.091 1.091 1.091h13.091c.603 0 1.091-.489 1.091-1.091v-3.273h3.273c.603 0 1.091-.489 1.091-1.091V5.454c0-.603-.489-1.091-1.091-1.091zM6.546 2.182h10.908v2.182H6.546zm10.908 19.636H6.546v-6.546h10.908zm4.363-4.363h-2.181v-3.273c0-.603-.489-1.091-1.091-1.091H5.454c-.603 0-1.091.489-1.091 1.091v3.273H2.181V6.546h19.637z"/><path fill="#fff" d="M14.182 17.454H9.788a1.091 1.091 0 0 0 0 2.182h.032h-.002h4.394a1.091 1.091 0 0 0 0-2.182h-.032zm3.592-8.407a1.092 1.092 0 1 0 .772-.319h-.001a1.1 1.1 0 0 0-.771.32z"/></svg>
                            </button>
                            <button id="pdf-expand" title="Expand PDF viewer" aria-label="Expand PDF viewer">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><path fill="currentColor" d="M9.79 12.79L4 18.59V17a1 1 0 0 0-2 0v4a1 1 0 0 0 .08.38a1 1 0 0 0 .54.54A1 1 0 0 0 3 22h4a1 1 0 0 0 0-2H5.41l5.8-5.79a1 1 0 0 0-1.42-1.42M21.92 2.62a1 1 0 0 0-.54-.54A1 1 0 0 0 21 2h-4a1 1 0 0 0 0 2h1.59l-5.8 5.79a1 1 0 0 0 0 1.42a1 1 0 0 0 1.42 0L20 5.41V7a1 1 0 0 0 2 0V3a1 1 0 0 0-.08-.38"/></svg>
                            </button>
                        </div>
                    </div>
                </div>
                {% else %}
                {% if ".com" in i.videoSrc %}
                <div id="player">
                    <iframe
                        src="{{ i.videoSrc }}"
                        allowfullscreen
                        allowtransparency
                        allow="autoplay"
                        title="Embedded video player for {{ i.title }}"
                        aria-label="Embedded video player for {{ i.title }}"
                    ></iframe>
                </div>
                {% else %}
                <video id="player" playsinline controls data-poster="{{ i.imgSrc }}" aria-label="Video player for {{ i.title }}">
                    {% if "mp4" in i.videoSrc %}
                    <source src="{{ i.videoSrc }}" type="video/mp4" />
                    {% elif "webm" in i.videoSrc %}
                    <source src="{{ i.videoSrc }}" type="video/webm" />
                    {% elif "ogg" in i.videoSrc %}
                    <source src="{{ i.videoSrc }}" type="video/ogg" />
                    {% elif "mov" in i.videoSrc %}
                    <source src="{{ i.videoSrc }}" type="video/quicktime" />
                    {% endif %}
                </video>
                {% endif %}
                {% endif %}
            </div>
            <div id="info">
                <div id="specs">
                    <h1 id="contentTitle">{{ i.title }}{% if i.Screenplay == "Sole" and (i.versioning == "Yes" or i.versioning == "Completed") and i.versionInfo and i.versionInfo.currentVersion %}<span class="version-badge">v{{ i.versionInfo.currentVersion }}</span>{% endif %}</h1>
                    <small id="date">{{ i.date }}</small>
                </div>
                <div id="tags">
                    {% set roles = i.role.split('/') %}
                    <div class="roles">
                        {% for r in roles %}
                        <a class="role-tag" href="/explore/?roles={{ r | urlencode }}">{{ r }}</a>
                        {% endfor %}
                    </div>
                    <span id="divider"> | </span>
                    <a class="type-tag" href="/explore/?types={{ i.type | urlencode }}">{{ i.type }}</a>
                </div>
                
                <div class="project-buttons">
                    <button class="credits-button" id="credits-toggle" aria-label="Show credits" title="Show credits">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16"><path fill="#fff" d="M8 8.5c3.85 0 7 2.5 7 4.5a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2c0-2 3.15-4.5 7-4.5M8 10c-1.61 0-3.064.526-4.092 1.234C2.798 12.001 2.5 12.733 2.5 13a.5.5 0 0 0 .5.5h10a.5.5 0 0 0 .5-.5c0-.267-.297-1-1.408-1.766C11.064 10.526 9.609 10 8 10m0-9a3.5 3.5 0 1 1 0 7a3.5 3.5 0 0 1 0-7m0 1.5a2 2 0 1 0 0 4a2 2 0 0 0 0-4"/></svg>
                        Credits
                    </button>
                    
                    {% if i.Screenplay == "Yes" or i.Screenplay == "Sole" %}
                    <a href="{{ i.PDFSrc }}" target="_blank" class="view-screenplay-button" aria-label="View screenplay PDF for {{ i.title }}" title="View screenplay PDF for {{ i.title }}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"><path fill="currentColor" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zm4 18H6V4h7v5h5z"/></svg>
                        View Screenplay
                    </a>
                    {% endif %}
                    
                    {% if (i.versioning == "Yes" or i.versioning == "Completed") and i.versionInfo and i.versionInfo.currentVersion %}
                    <button class="version-button" id="version-toggle" aria-label="Show screenplay version history" title="Show screenplay version history">
                        v{{ i.versionInfo.currentVersion }}
                    </button>
                    {% endif %}
                </div>
            </div>
        </section>
        <aside id="credits">
            <div id="credits-header">
                <h2>Credits</h2>
            </div>
            <div id="credits-container">
                <ul>
                    {% for role, names in i.credits %}
                        <li>
                            <strong>{{ role }}:</strong>
                            <div class="credit-names">
                                {% for name in names %}
                                    <span class="credit-name">{{ name }}</span>
                                {% endfor %}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </aside>
    </div>
    <div id="more">
        {% if i.Screenplay == "Yes" or i.Screenplay == "Sole" %}
        <a href="{{ i.PDFSrc }}" target="_blank" id="attachments">
            <img id="screenplay" src="/resources/images/icons/screenplay-icon.webp" alt="Screenplay icon" aria-hidden="false">
            <div id="view-container"><span id="view">View</span></div>
        </a>
        {% endif %}
        <section id="description" aria-label="Project description">
            <p>{{ i.description | processDescriptionLinks | safe }}</p>
        </section>
        {% if (i.versioning == "Yes" or i.versioning == "Completed") and i.versionInfo and i.versionInfo.currentVersion %}
        <section id="version-history" aria-label="Screenplay version history">
            <div class="version-header">
                <h3>Screenplay Version History{% if i.versioning == "Yes" %} <span class="dev-status">(In Active Development)</span>{% endif %}</h3>
            <button class="version-toggle" type="button" aria-expanded="false" aria-label="Show expanded screenplay version history">
                    <span class="version-summary">{% if i.versioning == "Completed" %}Final{% else %}Current{% endif %}: v{{ i.versionInfo.currentVersion }} ({% if i.versionInfo.currentVersion == 1 %}{{ i.date | dateFormat }}{% else %}{{ i.versionInfo.versions[i.versionInfo.currentVersion - 1].uploadDate | dateFormat }}{% endif %})</span>
                    <span class="toggle-arrow">▼</span>
                </button>
            </div>
            <div class="version-list" aria-hidden="true">
                <ul>
                    {% for version in i.versionInfo.versions %}
                    <li class="version-item{% if loop.index == i.versionInfo.currentVersion %} current{% endif %}">
                        <span class="version-number">v{{ loop.index }}</span>
                        <span class="version-date">
                            {% if loop.index == 1 %}
                                {{ i.date }}
                            {% else %}
                                {{ version.uploadDate | dateFormat }}
                            {% endif %}
                        </span>
                        {% if loop.index == i.versionInfo.currentVersion %}
                        <span class="current-badge">{% if i.versioning == "Completed" %}Final{% else %}Current{% endif %}</span>
                        {% endif %}
                    </li>
                    {% endfor %}
                </ul>
            </div>
        </section>
        {% endif %}
    </div>
</div>

<div class="mobile-credits-overlay" id="mobile-credits-overlay" role="dialog" aria-modal="true" aria-label="Mobile credits popup">
    <div class="mobile-credits-popup">
        <div class="credits-header">
            <h2>Credits</h2>
            <button class="credits-close" id="credits-close" aria-label="Close credits popup" title="Close credits">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20"><path fill="currentColor" d="M10 8.586L2.929 1.515L1.515 2.929L8.586 10l-7.071 7.071l1.414 1.414L10 11.414l7.071 7.071l1.414-1.414L11.414 10l7.071-7.071l-1.414-1.414z"/></svg>
            </button>
        </div>
        <ul>
            {% for role, names in i.credits %}
                <li>
                    <strong>{{ role }}:</strong>
                    <div class="credit-names">
                        {% for name in names %}
                            <span class="credit-name">{{ name }}</span>
                        {% endfor %}
                    </div>
                </li>
            {% endfor %}
        </ul>
    </div>
</div>

{% if (i.versioning == "Yes" or i.versioning == "Completed") and i.versionInfo and i.versionInfo.currentVersion %}
<div class="mobile-version-overlay" id="mobile-version-overlay" role="dialog" aria-modal="true" aria-label="Mobile screenplay version history popup">
    <div class="mobile-version-popup">
        <div class="version-header">
            <h3>Screenplay Version History</h3>
            <button class="version-close" id="version-close" aria-label="Close version history popup" title="Close screenplay version history">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20"><path fill="currentColor" d="M10 8.586L2.929 1.515L1.515 2.929L8.586 10l-7.071 7.071l1.414 1.414L10 11.414l7.071 7.071l1.414-1.414L11.414 10l7.071-7.071l-1.414-1.414z"/></svg>
            </button>
        </div>
        <div class="version-list">
            <ul>
                {% for version in i.versionInfo.versions %}
                <li class="version-item{% if loop.index == i.versionInfo.currentVersion %} current{% endif %}">
                    <span class="version-number">v{{ loop.index }}</span>
                    <span class="version-date">
                        {% if loop.index == 1 %}
                            {{ i.date }}
                        {% else %}
                            {{ version.uploadDate | dateFormat }}
                        {% endif %}
                    </span>
                    {% if loop.index == i.versionInfo.currentVersion %}
                    <span class="current-badge">{% if i.versioning == "Completed" %}Final{% else %}Current{% endif %}</span>
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
        </div>
    </div>
</div>
{% endif %}
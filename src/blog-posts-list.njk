---
layout: base.njk
title: All Blog Posts | Jonathan Thompson
pagecss: <link rel="stylesheet" href="/resources/css/blog.css">
pagejs: <script src="/resources/js/blog.js" defer></script>
pagination:
  data: collections.blogPosts
  size: 8
  alias: posts
permalink: "/blog/posts/{% if pagination.pageNumber > 0 %}page-{{ pagination.pageNumber + 1 }}/{% endif %}index.html"
---

<div id="blog-page">
    <header class="blog-header pop-in">
        <h1 class="blog-title">All Posts</h1>
        <p class="blog-subtitle">{{ collections.blogPosts.length }} post{% if collections.blogPosts.length != 1 %}s{% endif %} • Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</p>
    </header>

    <div class="categories-strip pop-in">
        <a href="/blog/" class="category-tag">← Back to Blog</a>
        <a href="/blog/tags/" class="category-tag">Browse by Tag</a>
    </div>

    <div class="blog-posts-list">
        {% for post in posts %}
        <article class="blog-post-item pop-in">
            <div class="post-meta">
                {% for tag in post.data.tags %}
                <a href="/blog/tags/{{ tag | slugify }}/" class="post-category {{ tag | slugify }}">{{ tag | titleCase }}</a>
                {% endfor %}
                <span class="post-date">{{ post.data.date | dateFormat }}</span>
                <span class="reading-time">{{ post.templateContent | readingTime }} min read</span>
            </div>
            <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
            <p class="post-excerpt">{{ post.data.excerpt }}</p>
            <a href="{{ post.url }}" class="read-more">Read More →</a>
        </article>
        {% endfor %}
    </div>

    {% if pagination.pages.length > 1 %}
    <nav class="pagination pop-in">
        <div class="pagination-links">
            {% if pagination.pageNumber > 0 %}
            {% if pagination.pageNumber == 1 %}
            <a href="/blog/posts/" class="pagination-link prev">← Previous</a>
            {% else %}
            <a href="/blog/posts/page-{{ pagination.pageNumber }}/" class="pagination-link prev">← Previous</a>
            {% endif %}
            {% endif %}

            {% for pageNum in range(0, pagination.pages.length) %}
            {% if pageNum == pagination.pageNumber %}
            <span class="pagination-link current">{{ pageNum + 1 }}</span>
            {% else %}
            {% if pageNum == 0 %}
            <a href="/blog/posts/" class="pagination-link">{{ pageNum + 1 }}</a>
            {% else %}
            <a href="/blog/posts/page-{{ pageNum + 1 }}/" class="pagination-link">{{ pageNum + 1 }}</a>
            {% endif %}
            {% endif %}
            {% endfor %}

            {% if pagination.pageNumber < pagination.pages.length - 1 %}
            <a href="/blog/posts/page-{{ pagination.pageNumber + 2 }}/" class="pagination-link next">Next →</a>
            {% endif %}
        </div>
    </nav>
    {% endif %}
</div>

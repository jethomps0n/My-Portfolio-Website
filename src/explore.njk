---
layout: base.njk
title: Explore All Work
og_title: Explore All Work – Jonathan Thompson
description: Explore the projects and works of Jonathan Thompson, showcasing a variety of roles including writing, editing, directing, and producing across the world of film and television.
canonical: https://itsjonathanthompson.com/explore/
og_image:
pagecss: <link rel="stylesheet" href="/resources/css/explore.css">
pagejs: <script src="/resources/js/explore.js" defer></script>
---

<h1 class="visually-hidden">{{ title }}</h1>
<section class="visually-hidden" aria-labelledby="all-works-index">
  <h2 id="all-works-index">All works/projects</h2>
  <ul>
    {% set sortedData = data | sortByDate %}
    {% for i in sortedData %}
      {% set roles = i.role.split('/') %}
      <li>
        <a href="/explore/{{ i.slug }}/">{{ i.title }}</a>
        {% if i.date %} — <time datetime="{{ i.date | isoDate }}">{{ i.date }}</time>{% endif %}
        {% if roles.length or i.type %}
          —
          {% if roles.length %}
            {{ roles | join(", ") }}
          {% endif %}
          {% if roles.length and i.type %} — {% endif %}
          {% if i.type %}
            {{ i.type }}
          {% endif %}
        {% endif %}
         {% if i.Screenplay == "Yes" or i.Screenplay == "Sole" %}
          — {% if i.Screenplay != "Sole" %}Contains{% endif %} Screenplay{% if i.versioning == "Yes" or i.versioning == "Completed" %} (v{{ i.versionInfo.currentVersion }}){% endif %}
        {% endif %}
      </li>
    {% endfor %}
  </ul>

  {% set roleSet = [] %}
  {% set typeSet = [] %}

  {% for item in data %}
    {% if item.role %}
      {% for r in item.role.split('/') %}
        {% set rClean = r | trim %}
        {% if rClean and (rClean not in roleSet) %}
          {% set roleSet = roleSet.concat([rClean]) %}
        {% endif %}
      {% endfor %}
    {% endif %}

    {% if item.type %}
      {% set tClean = item.type | trim %}
      {% if tClean and (tClean not in typeSet) %}
        {% set typeSet = typeSet.concat([tClean]) %}
      {% endif %}
    {% endif %}
  {% endfor %}

  <h3>Browse by role</h3>
  <ul>
    {% for role in roleSet %}
      <li>
        <a href="/explore/?roles={{ role | urlencode }}">{{ role }}</a>
      </li>
    {% endfor %}
  </ul>

  <h3>Browse by type</h3>
  <ul>
    {% for t in typeSet %}
      <li>
        <a href="/explore/?types={{ t | urlencode }}">{{ t }}</a>
      </li>
    {% endfor %}
  </ul>
</section>

<div id="explore-page">
    <div class="top-controls">
        <div id="search-container" class="pop-in">
            <input id="search-input" type="text" placeholder="Search..." />
            <button id="clear-search" aria-label="Clear search">&#x2715;</button>
        </div>
        <div class="search-and-filters">
            <button class="filters-button" id="mobile-filters-btn" aria-label="Open filters">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 48 48">
                    <defs>
                        <mask id="ipTFilter0">
                            <path fill="#555555" stroke="#fff" stroke-linejoin="round" stroke-width="4" d="m6 9l14.4 16.818v12.626L27.6 42V25.818L42 9z"/>
                        </mask>
                    </defs>
                    <path fill="#fff" d="M0 0h48v48H0z" mask="url(#ipTFilter0)"/>
                </svg>
                Filters
            </button>
        </div>
    </div>

    <div id="query-interface">
        <aside id="filter-section" class="pop-in">
            <div class="filter-header">
                <h2>Filter By</h2>
                <span id="filter-count">0</span>
                <button id="clear-filters" type="button" aria-label="Clear all filters">Clear All</button>
            </div>

            <div class="filter-group" id="filter-role">
                <h3>ROLE <button class="toggle open" type="button" aria-controls="options-role" aria-expanded="true"></button></h3>
                <div class="options" id="options-role">
                    <label><input type="checkbox" value="Director">Director</label>
                    <label><input type="checkbox" value="Writer">Writer</label>
                    <label><input type="checkbox" value="Editor">Editor</label>
                    <label><input type="checkbox" value="Producer">Producer</label>
                    <div class="more">
                        <label><input type="checkbox" value="DP">DP <small>(Director of Photography)</small></label>
                        <label><input type="checkbox" value="Camera Operator">Camera Operator</label>
                        <label><input type="checkbox" value="Production Assistant">Production Assistant</label>
                        <label><input type="checkbox" value="Sound Recordist">Sound Recordist</label>
                        <label><input type="checkbox" value="Actor">Actor</label>
                        <label><input type="checkbox" value="Gaffer">Gaffer</label>
                    </div>
                    <button class="show-more" type="button"><span class="text">Show More</span> <span class="arrow">▼</span></button>
                </div>
            </div>

            <div class="filter-group" id="filter-type">
                <h3>TYPE <button class="toggle open" type="button" aria-controls="options-type" aria-expanded="true"></button></h3>
                <div class="options" id="options-type">
                    <label><input type="checkbox" value="Short Film">Short Films</label>
                    <label><input type="checkbox" value="Rescore">Rescores</label>
                    <label><input type="checkbox" value="Advertisement">Advertisements</label>
                    <label><input type="checkbox" value="Documentary">Documentaries</label>
                    <div class="more">
                        <label><input type="checkbox" value="Video Essay">Video Essays</label>
                        <label><input type="checkbox" value="Spec Script">Spec Scripts</label>
                        <label><input type="checkbox" value="Feature Film">Feature Films</label>
                        <label><input type="checkbox" value="Audio Mix">Audio Mixes</label>
                        <label><input type="checkbox" value="Show">Shows</label>
                    </div>
                    <button class="show-more" type="button"><span class="text">Show More</span> <span class="arrow">▼</span></button>
                </div>
            </div>

            <div class="filter-group" id="filter-date">
                <h3>DATE RANGE <button class="toggle open" type="button" aria-controls="options-date" aria-expanded="true"></button></h3>
                <div class="options" id="options-date">
                    <label><input type="radio" name="date" value="30"> Last 30 Days</label>
                    <label><input type="radio" name="date" value="90"> Last 90 Days</label>
                    <label><input type="radio" name="date" value="365"> Last Year</label>
                    <div class="custom-range">
                        <input type="date" id="start-date"><span> – </span>
                        <input type="date" id="end-date">
                        <button id="set-custom" type="button" aria-label="Set custom date range">Set</button>
                    </div>
                </div>
            </div>
        </aside>

        <section id="results-section" class="pop-in">
            <div id="active-filters"></div>
            <div class="results-header">
                <span id="results-count"></span>
                <div class="sort">
                    <label for="sort-select">Sort By</label>
                    <div class="sort-wrapper">
                        <select id="sort-select">
                            <option value="newest">Newest First</option>
                            <option value="oldest">Oldest First</option>
                            <option value="az">A-Z</option>
                            <option value="za">Z-A</option>
                        </select>
                        <span class="select-arrow">▼</span>
                    </div>
                </div>
            </div>
            <div id="results-list"></div>
            <div id="pagination"></div>
        </section>
    </div>
</div>

<div class="mobile-filter-overlay" id="mobile-filter-overlay"></div>
<div class="mobile-filter-popup" id="mobile-filter-popup">
    <div class="mobile-filter-header">
        <h2>Filters</h2>
        <button class="mobile-filter-close" id="mobile-filter-close" aria-label="Close filters">&times;</button>
    </div>
    <div class="mobile-filter-content" id="mobile-filter-content">
    </div>
    <div class="mobile-filter-footer">
        <button class="clear-filters" id="mobile-clear-filters" aria-label="Clear all filters">Clear All</button>
    </div>
</div>
layout: base.njk
title: Contact | Jonathan Thompson
pagecss: <link rel="stylesheet" href="/resources/css/contact.css">
pagejs: <script src="/resources/js/contact.js" defer></script>
---

<div id="contact-page">
    <div id="contact-hero" class="pop-in">
        <div class="hero-content">
            <h1 class="contact-title">Let's Collaborate</h1>
            <p class="contact-subtitle">Ready to bring your vision to life</p>
            <p class="contact-description">Whether you have a project in mind, need a creative partner, or just want to connect about filmmaking, I'd love to hear from you.</p>
        </div>
    </div>

    <div id="contact-content">
        <section class="contact-section pop-in">
            <div class="section-content">
                <div class="contact-grid">
                    <div class="contact-form-container">
                        <h2>Send a Message</h2>
                        <form id="contact-form" class="contact-form">
                            <div class="form-group">
                                <label for="name">Name *</label>
                                <input type="text" id="name" name="name" required>
                            </div>
                            
                            <div class="form-group">
                                <label for="email">Email *</label>
                                <input type="email" id="email" name="email" required>
                            </div>
                            
                            <div class="form-group">
                                <label for="subject">Subject</label>
                                <input type="text" id="subject" name="subject">
                            </div>
                            
                            <div class="form-group">
                                <label for="project-type">Project Type</label>
                                <select id="project-type" name="project-type">
                                    <option value="">Select type (optional)</option>
                                    <option value="short-film">Short Film</option>
                                    <option value="documentary">Documentary</option>
                                    <option value="commercial">Commercial/Advertisement</option>
                                    <option value="music-video">Music Video</option>
                                    <option value="editing">Editing Services</option>
                                    <option value="writing">Writing Services</option>
                                    <option value="collaboration">Creative Collaboration</option>
                                    <option value="other">Other</option>
                                </select>
                            </div>
                            
                            <div class="form-group">
                                <label for="message">Message *</label>
                                <textarea id="message" name="message" rows="6" required placeholder="Tell me about your project, vision, or what you'd like to discuss..."></textarea>
                            </div>
                            
                            <div class="form-actions">
                                <button type="submit" class="cta-button">Send Message</button>
                                <button type="reset" class="cta-button secondary">Clear Form</button>
                            </div>
                        </form>
                    </div>
                    
                    <div class="contact-info">
                        <h2>Get in Touch</h2>
                        
                        <div class="contact-methods">
                            <div class="contact-method">
                                <h3>Direct Contact</h3>
                                <p>For immediate inquiries or urgent project discussions.</p>
                                <a href="mailto:hello@itsjonathanthompson.com" class="contact-link">
                                    <span class="contact-icon">✉</span>
                                    hello@itsjonathanthompson.com
                                </a>
                            </div>
                            
                            <div class="contact-method">
                                <h3>Social & Portfolio</h3>
                                <p>Follow my work and connect on social platforms.</p>
                                <div class="social-links">
                                    <a href="https://www.linkedin.com/in/jethompsn/" target="_blank" class="social-link">
                                        <span class="social-icon">🔗</span>
                                        LinkedIn
                                    </a>
                                    <a href="https://www.instagram.com/jethompsn/" target="_blank" class="social-link">
                                        <span class="social-icon">📷</span>
                                        Instagram
                                    </a>
                                    <a href="https://www.youtube.com/@jethompsn" target="_blank" class="social-link">
                                        <span class="social-icon">🎬</span>
                                        YouTube
                                    </a>
                                </div>
                            </div>
                            
                            <div class="contact-method">
                                <h3>Response Time</h3>
                                <p>I typically respond to inquiries within 24-48 hours. For urgent matters, please mention "URGENT" in your subject line.</p>
                            </div>
                        </div>
                        
                        <div class="availability-status">
                            <h3>Current Availability</h3>
                            <div class="status-indicator">
                                <span class="status-dot available"></span>
                                <span class="status-text">Available for new projects</span>
                            </div>
                            <p class="status-description">Currently accepting new collaborations and client work for Q1 2025.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        
        <section class="contact-section pop-in">
            <div class="section-content">
                <div class="collaboration-info">
                    <h2>Working Together</h2>
                    <div class="collaboration-grid">
                        <div class="collaboration-item">
                            <h3>Project Development</h3>
                            <p>From initial concept to final delivery, I work closely with clients to ensure creative vision aligns with practical execution.</p>
                        </div>
                        <div class="collaboration-item">
                            <h3>Creative Flexibility</h3>
                            <p>Whether you need a writer, editor, director, or multi-role contributor, I adapt to project needs and team dynamics.</p>
                        </div>
                        <div class="collaboration-item">
                            <h3>Professional Standards</h3>
                            <p>Committed to meeting deadlines, maintaining clear communication, and delivering high-quality work that exceeds expectations.</p>
                        </div>
                    </div>
                </div>
            </section>
        </section>
    </div>
</div>
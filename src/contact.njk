---
layout: base.njk
title: Contact
pagecss: <link rel="stylesheet" href="/resources/css/contact.css">
pagejs: <script src="/resources/js/contact.js" defer></script>
---

<div id="contact-page">
    <section class="contact-hero pop-in">
        <div class="hero-content">
            <h1 class="contact-title">Let's Connect</h1>
            <p class="contact-subtitle">Whether it's work, collaboration, or just saying hello</p>
            <div class="availability-status">
                <span class="status-indicator"></span>
                Always happy to connect
            </div>
        </div>
    </section>

    <div class="contact-grid">
        <div class="contact-methods pop-in">
            <h2>Get In Touch</h2>
            
            <a href="mailto:jonathan@itsjonathanthompson.com" class="method-card primary clickable-card">
                <div class="method-icon">
                    <img src="/resources/images/icons/email.png" alt="Email" />
                </div>
                <div class="method-content">
                    <h3>Email Me</h3>
                    <p>The best way to reach out - I check this regularly</p>
                    <span class="method-link">jonathan@itsjonathanthompson.com</span>
                </div>
            </a>

            <a href="https://www.linkedin.com/in/jethompsn/" target="_blank" class="method-card clickable-card">
                <div class="method-icon">
                    <img src="/resources/images/icons/LinkedIn-alt2.png" alt="LinkedIn" />
                </div>
                <div class="method-content">
                    <h3>Professional Contact</h3>
                    <p>Connect with me on LinkedIn</p>
                    <span class="method-link">LinkedIn Profile</span>
                </div>
            </a>

            <a href="https://files.itsjonathanthompson.com/Jonathan+Thompson+-+Resume.pdf" target="_blank" class="method-card resume-card clickable-card">
                <div class="method-icon">
                    <img src="/resources/images/icons/document.png" alt="Resume" />
                </div>
                <div class="method-content">
                    <h3>Looking for my resume?</h3>
                    <p>Get a comprehensive overview of my experience and skills</p>
                    <span class="method-link">Download Resume</span>
                </div>
            </a>

            <div class="social-grid">
                <div class="social-tiles">
                    <a href="https://www.youtube.com/@jethompsn" target="_blank" class="social-tile youtube clickable-tile">
                        <div class="social-icon">
                            <img src="/resources/images/icons/YouTube-alt1.png" alt="YouTube" />
                        </div>
                        <div class="social-content">
                            <h4>YouTube</h4>
                            <span class="social-link">@jethompsn</span>
                        </div>
                    </a>
                    
                    <a href="https://www.instagram.com/jethompsn/" target="_blank" class="social-tile instagram clickable-tile">
                        <div class="social-icon">
                            <img src="/resources/images/icons/Instagram-alt1.png" alt="Instagram" />
                        </div>
                        <div class="social-content">
                            <h4>Instagram</h4>
                            <span class="social-link">@jethompsn</span>
                        </div>
                    </a>
                    
                    <a href="https://github.com/jethomps0n" target="_blank" class="social-tile github clickable-tile">
                        <div class="social-icon">
                            <img src="/resources/images/icons/GitHub-alt1.png" alt="GitHub" />
                        </div>
                        <div class="social-content">
                            <h4>GitHub</h4>
                            <span class="social-link">@jethomps0n</span>
                        </div>
                    </a>
                    
                    <a href="https://letterboxd.com/Jonathan_T/" target="_blank" class="social-tile letterboxd clickable-tile">
                        <div class="social-icon">
                            <img src="/resources/images/icons/Letterboxd-alt1.png" alt="Letterboxd" />
                        </div>
                        <div class="social-content">
                            <h4>Letterboxd</h4>
                            <span class="social-link">@Jonathan_T</span>
                        </div>
                    </a>
                </div>
            </div>
        </div>

        <div class="contact-form pop-in">
            <h2>Send Me a Message</h2>
            <p class="form-intro">Have something on your mind? I'd love to hear from you! Drop me a message and I'll get back to you as soon as I can.</p>
            
            <form class="contact-form-fields" action="https://api.web3forms.com/submit" method="POST">
                <input type="hidden" name="access_key" value="25b68a1f-b0e8-4083-b110-2fa5b71a5759">
                <input type="hidden" name="redirect" value="false">
                <input type="hidden" name="from_name" value="itsjonathanthompson.com">
                <input type="hidden" name="subject" id="dynamic-subject" value="Contact Form Submission">
                <div class="form-group">
                    <label for="name">Your Name</label>
                    <input type="text" id="name" name="Name" required>
                </div>
                
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="Email" required>
                </div>

                <div class="form-group">
                    <label for="connection-type">What's on your mind?<span class="required-asterisk"> *</span></label>
                    <select id="connection-type" name="Connection Type" required>
                        <option value="">What would you like to talk about?</option>
                        <option value="Work Opportunity">Work Opportunity</option>
                        <option value="Collaboration Request">Collaboration Request</option>
                        <option value="General Inquiry">General Inquiry</option>
                        <option value="Feedback">Feedback</option>
                        <option value="Just Saying Hi">Just Saying Hi</option>
                        <option value="Something Else">Something Else</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="interest-area">Area of Interest (Optional)</label>
                    <select id="interest-area" name="Area of Interest">
                        <option value="">Any specific area?</option>
                        <option value="Video Editing">Video Editing</option>
                        <option value="Writing/Screenwriting">Writing/Screenwriting</option>
                        <option value="Directing">Directing</option>
                        <option value="Producing">Producing</option>
                        <option value="Cinematography">Cinematography</option>
                        <option value="Music/Sound Design">Music/Sound Design</option>
                        <option value="Creative Work">Creative Work</option>
                        <option value="Something Else">Something Else</option>
                    </select>
                </div>
                
                <div class="form-group full-width">
                    <label for="message">Your Message</label>
                    <textarea id="message" name="Message" rows="6" placeholder="What's on your mind? I'd love to hear from you!" required></textarea>
                </div>

                <input type="checkbox" name="botcheck" class="hidden" style="display: none;">
                
                <button type="submit" class="submit-btn">
                    <span>Send Message</span>
                    <div class="btn-glow"></div>
                </button>
                <div id="result"></div>
            </form>
        </div>
    </div>

    <section class="response-info pop-in">
        <div class="info-content">
            <h3>What happens next?</h3>
            <div class="response-steps">
                <div class="step">
                    <div class="step-number">1</div>
                    <div class="step-content">
                        <h4>I'll Read It</h4>
                        <p>I personally read every message that comes through</p>
                    </div>
                </div>
                <div class="step">
                    <div class="step-number">2</div>
                    <div class="step-content">
                        <h4>Quick Response</h4>
                        <p>You'll hear back from me within 24 hours</p>
                    </div>
                </div>
                <div class="step">
                    <div class="step-number">3</div>
                    <div class="step-content">
                        <h4>Let's Connect</h4>
                        <p>We can continue the conversation however works best for you</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
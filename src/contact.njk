---
layout: base.njk
title: Contact | Jonathan Thompson
pagecss: <link rel="stylesheet" href="/resources/css/contact.css">
pagejs: <script src="/resources/js/contact.js" defer></script>
---

<div id="contact-page">
    <section class="contact-hero pop-in">
        <div class="hero-content">
            <h1 class="contact-title">Let's Connect</h1>
            <p class="contact-subtitle">Whether it's work, collaboration, or just saying hello</p>
            <div class="availability-status">
                <span class="status-indicator"></span>
                Always open to new connections
            </div>
        </div>
    </section>

    <div class="contact-grid">
        <div class="contact-methods pop-in">
            <h2>Get In Touch</h2>
            
            <div class="method-card primary">
                <div class="method-icon">📧</div>
                <div class="method-content">
                    <h3>Direct Email</h3>
                    <p>For work opportunities, collaborations, or general inquiries</p>
                    <a href="mailto:hello@itsjonathanthompson.com" class="method-link">hello@itsjonathanthompson.com</a>
                </div>
            </div>

            <div class="method-card">
                <div class="method-icon">💼</div>
                <div class="method-content">
                    <h3>Professional Network</h3>
                    <p>Connect for career opportunities and professional networking</p>
                    <a href="https://www.linkedin.com/in/jethompsn/" target="_blank" class="method-link">LinkedIn Profile</a>
                </div>
            </div>

            <div class="method-card">
                <div class="method-icon">🎬</div>
                <div class="method-content">
                    <h3>Personal & Creative</h3>
                    <p>Follow my journey and connect on a more personal level</p>
                    <a href="https://www.instagram.com/jethompsn/" target="_blank" class="method-link">@jethompsn</a>
                </div>
            </div>
        </div>

        <div class="contact-form pop-in">
            <h2>Start a Conversation</h2>
            <p class="form-intro">Whether you're a recruiter, potential collaborator, friend, or just want to connect - I'd love to hear from you!</p>
            
            <form class="contact-form-fields" action="#" method="POST">
                <div class="form-group">
                    <label for="name">Your Name</label>
                    <input type="text" id="name" name="name" required>
                </div>
                
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" required>
                </div>

                <div class="form-group">
                    <label for="connection-type">What brings you here?</label>
                    <select id="connection-type" name="connection-type">
                        <option value="">How can we connect?</option>
                        <option value="job-opportunity">Job Opportunity</option>
                        <option value="collaboration">Creative Collaboration</option>
                        <option value="freelance">Freelance/Contract Work</option>
                        <option value="networking">Professional Networking</option>
                        <option value="student">Student/Learning</option>
                        <option value="personal">Personal Connection</option>
                        <option value="general-inquiry">General Inquiry</option>
                        <option value="other">Other</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="interest-area">Area of Interest (Optional)</label>
                    <select id="interest-area" name="interest-area">
                        <option value="">Select if relevant</option>
                        <option value="video-editing">Video Editing</option>
                        <option value="writing">Writing/Screenwriting</option>
                        <option value="directing">Directing</option>
                        <option value="producing">Producing</option>
                        <option value="cinematography">Cinematography</option>
                        <option value="music-sound">Music/Sound Design</option>
                        <option value="photography">Photography</option>
                        <option value="general-creative">General Creative</option>
                        <option value="non-creative">Non-Creative</option>
                        <option value="personal">Just Want to Connect</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="timeline">Timeline (Optional)</label>
                    <select id="timeline" name="timeline">
                        <option value="">When would you like to connect?</option>
                        <option value="immediate">Right away</option>
                        <option value="soon">Within a few weeks</option>
                        <option value="month">Within a month</option>
                        <option value="future">Future opportunity</option>
                        <option value="no-timeline">No specific timeline</option>
                        <option value="casual">Just whenever - no rush!</option>
                    </select>
                </div>
                
                <div class="form-group full-width">
                    <label for="message">Your Message</label>
                    <textarea id="message" name="message" rows="6" placeholder="Tell me about yourself, what you're working on, or what you'd like to discuss. Could be work-related, creative collaboration, or just saying hello - I'm open to all kinds of connections!"></textarea>
                </div>
                
                <button type="submit" class="submit-btn">
                    <span>Send Message</span>
                    <div class="btn-glow"></div>
                </button>
            </form>
        </div>
    </div>

    <section class="response-info pop-in">
        <div class="info-content">
            <h3>What happens next?</h3>
            <div class="response-steps">
                <div class="step">
                    <div class="step-number">1</div>
                    <div class="step-content">
                        <h4>Quick Response</h4>
                        <p>I'll get back to you within 24 hours</p>
                    </div>
                </div>
                <div class="step">
                    <div class="step-number">2</div>
                    <div class="step-content">
                        <h4>Let's Chat</h4>
                        <p>We can set up a call, video chat, or continue via email</p>
                    </div>
                </div>
                <div class="step">
                    <div class="step-number">3</div>
                    <div class="step-content">
                        <h4>Open to Everything</h4>
                        <p>Whether it's work, collaboration, friendship, or creative projects - let's see where it goes!</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
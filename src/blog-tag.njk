---
layout: base.njk
pagecss: <link rel="stylesheet" href="/resources/css/blog.css">
pagejs: <script src="/resources/js/blog.js" defer></script>
pagination:
  data: collections.tagPaginationData
  size: 1
  alias: tagPage
  addAllPagesToCollections: true
permalink: "/blog/tags/{{ tagPage.tag | slugify }}/{% if tagPage.pageNumber > 0 %}page-{{ tagPage.pageNumber + 1 }}/{% endif %}"
eleventyComputed:
  title: "{{ tagPage.tag | titleCase }} Posts"
  og_title: "{{ tagPage.tag | titleCase }} Posts — Jonathan Thompson"
  description: "Browse all my blog posts tagged with {{ tagPage.tag | titleCase }}."
  canonical: "https://itsjonathanthompson.com/blog/tags/{{ tagPage.tag | slugify }}/"
  og_image:
---

<div id="blog-page">
    {% set tag = tagPage.tag %}
    {% set currentPage = tagPage.pageNumber %}
    {% set totalPages = tagPage.totalPages %}
    {% set allTagPosts = tagPage.totalPosts %}
    {% set posts = tagPage.posts %}

    <header class="blog-header pop-in" role="banner" aria-label="{{ tag | titleCase }} Tag Posts Header">
        <h1 class="blog-title">{{ tag | titleCase }}</h1>
        <p class="blog-subtitle">{{ allTagPosts }} post{% if allTagPosts != 1 %}s{% endif %} tagged with "{{ tag | titleCase }}"{% if totalPages > 1 %} • Page {{ currentPage + 1 }} of {{ totalPages }}{% endif %}</p>
    </header>

    <div class="categories-strip pop-in" aria-label="Blog Categories">
        <a href="/blog/" class="category-tag" aria-label="Back to Blog">← Back to Blog</a>
        <a href="/blog/tags/" class="category-tag" aria-label="Browse all tags">All Tags</a>
        <a href="/blog/posts/" class="category-tag" aria-label="Browse all posts">All Posts</a>
    </div>

    <div class="blog-posts-list">
        {% for post in tagPage.posts %}
        <article class="blog-post-item pop-in">
            <div class="post-meta">
                <div class="post-meta-tags">
                    {% for postTag in post.data.tags %}
                    <a href="/blog/tags/{{ postTag | slugify }}/" class="post-category {{ postTag | slugify }}" aria-label="Show posts tagged {{ postTag | titleCase }}">{{ postTag | titleCase }}</a>
                    {% endfor %}
                </div>
                <div class="post-meta-info">
                    <span class="post-date">{{ post.data.date | dateFormat }}</span>
                    <span class="reading-time">{{ post.templateContent | readingTime }} min read</span>
                </div>
            </div>
            <h2><a href="{{ post.url }}" aria-label="Read full post: {{ post.data.title }}">{{ post.data.title }}</a></h2>
            <p class="post-excerpt">{{ post.data.excerpt }}</p>
            <a href="{{ post.url }}" class="read-more" aria-label="Read more about {{ post.data.title }}">Read More →</a>
        </article>
        {% endfor %}
    </div>

    {% if tagPage.totalPages > 1 %}
    <nav class="pagination pop-in" aria-label="Tag Pagination">
        <div class="pagination-links">
            {% if tagPage.pageNumber > 0 %}
            {% if tagPage.pageNumber == 1 %}
            <a href="/blog/tags/{{ tag | slugify }}/" class="pagination-link prev" aria-label="Previous page">← Previous</a>
            {% else %}
            <a href="/blog/tags/{{ tag | slugify }}/page-{{ tagPage.pageNumber }}/" class="pagination-link prev" aria-label="Previous page">← Previous</a>
            {% endif %}
            {% endif %}

            {% for pageNum in range(0, tagPage.totalPages) %}
            {% if pageNum == tagPage.pageNumber %}
            <span class="pagination-link current">{{ pageNum + 1 }}</span>
            {% else %}
            {% if pageNum == 0 %}
            <a href="/blog/tags/{{ tag | slugify }}/" class="pagination-link" aria-label="Go to page {{ pageNum + 1 }}">{{ pageNum + 1 }}</a>
            {% else %}
            <a href="/blog/tags/{{ tag | slugify }}/page-{{ pageNum + 1 }}/" class="pagination-link" aria-label="Go to page {{ pageNum + 1 }}">{{ pageNum + 1 }}</a>
            {% endif %}
            {% endif %}
            {% endfor %}

            {% if tagPage.pageNumber < tagPage.totalPages - 1 %}
            <a href="/blog/tags/{{ tag | slugify }}/page-{{ tagPage.pageNumber + 2 }}/" class="pagination-link next" aria-label="Next page">Next →</a>
            {% endif %}
        </div>
    </nav>
    {% endif %}

    {% if tagPage.totalPosts == 0 %}
    <div class="empty-state pop-in" role="status" aria-live="polite">
        <h3>No posts found</h3>
        <p>There are no posts tagged with "{{ tag | titleCase }}" yet.</p>
        <a href="/blog/" class="read-more" aria-label="Back to Blog">← Back to Blog</a>
    </div>
    {% endif %}
</div>
